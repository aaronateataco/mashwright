{
  "sheet": "hooks",
  "about": "Every place the mod touches Brotato. kind: extension = ModLoader script extension overriding methods (only for scripts with no compiled subclasses: the boot path applies extensions after Brotato's autoloads, and reloading a compiled subclass wipes it); call = the mod calls or connects to this Brotato function/property/signal directly; boot = loose file next to the game exe. Members are checked by preflight against the decompiled game (in the target script or its parents).",
  "columns": ["id", "kind", "target", "members", "our_file", "purpose"],
  "rows": [
    {"id": "hook_boot",            "kind": "boot",      "target": "override.cfg", "members": ["autoload"], "our_file": "boot/huepotato_boot.gd", "purpose": "Steam builds only load Workshop zips; hand {game}/mods/*.zip to ModLoader"},
    {"id": "hook_main",            "kind": "extension", "target": "res://main.gd", "members": ["_ready", "_on_WaveTimer_timeout", "_exit_tree"], "our_file": "extensions/main.gd", "purpose": "Start/stop the Hue run controller with each wave"},
    {"id": "hook_player",          "kind": "extension", "target": "res://entities/units/player/player.gd", "members": ["die", "_animation_node", "player_index"], "our_file": "extensions/player.gd", "purpose": "Hue's dead eyes and sound on death"},
    {"id": "hook_spawner_signals", "kind": "call",      "target": "res://global/entity_spawner.gd", "members": ["enemy_spawned", "enemy_respawned", "get_all_enemies"], "our_file": "src/hue_run.gd", "purpose": "Colour each enemy as it spawns; find enemies revealed by a switch"},
    {"id": "hook_enemy_nodes",     "kind": "call",      "target": "res://entities/units/enemies/enemy.gd", "members": ["_hitbox", "_hurtbox", "dead", "is_loot", "sprite", "get_charmed_by_player_index", "current_stats", "add_decaying_speed"], "our_file": "src/hue_tint.gd", "purpose": "Hide an enemy: fade, hitbox and hurtbox off, off the targetable layer"},
    {"id": "hook_boss",            "kind": "call",      "target": "res://entities/units/enemies/boss/boss.gd", "members": ["is_elite"], "our_file": "mod_main.gd", "purpose": "Bosses and elites stay colourless"},
    {"id": "hook_entity_outline",  "kind": "call",      "target": "res://entities/entity.gd", "members": ["add_outline", "remove_outline", "has_outline", "sprite"], "our_file": "src/hue_tint.gd", "purpose": "Coloured outline and tint (multiplied onto any tint another mod set, then restored)"},
    {"id": "hook_projectiles",     "kind": "call",      "target": "res://projectiles/projectile.gd", "members": ["_hitbox", "_sprite"], "our_file": "src/hue_run.gd", "purpose": "Enemy bullets take their shooter's colour and hide with it"},
    {"id": "hook_hitbox",          "kind": "call",      "target": "res://overlap/hitbox.gd", "members": ["from", "active", "enable", "disable"], "our_file": "src/hue_run.gd", "purpose": "Who shot a bullet; switch bullet damage off while hidden"},
    {"id": "hook_weapon_base",     "kind": "call",      "target": "res://weapons/melee/melee_weapon.gd", "members": ["should_shoot", "init_stats", "_hitbox", "_parent", "sprite", "current_stats", "outline_shader_mat"], "our_file": "src/hue_laser_ring.gd", "purpose": "The Laser Ring is Brotato's fist weapon scene with a script that extends MeleeWeapon: its hitbox stats are copied to each laser beam between the orbiting laser cannons"},
    {"id": "hook_weapon_data",     "kind": "call",      "target": "res://items/global/weapon_data.gd", "members": ["weapon_id", "scene", "stats", "upgrades_into", "sets", "type"], "our_file": "src/hue_registry.gd", "purpose": "Build the four Laser Ring tiers from fist_data/fist_stats and add them to ItemService.weapons"},
    {"id": "hook_item_service",    "kind": "call",      "target": "res://singletons/item_service.gd", "members": ["characters", "add_mod_item", "weapons"], "our_file": "src/hue_registry.gd", "purpose": "Register Hue Potato and Hue items"},
    {"id": "hook_progress",        "kind": "call",      "target": "res://singletons/progress_data.gd", "members": ["add_unlocked_by_default", "characters_unlocked"], "our_file": "src/hue_registry.gd", "purpose": "Unlock Hue Potato and difficulty entries"},
    {"id": "hook_run_data",        "kind": "call",      "target": "res://singletons/run_data.gd", "members": ["get_player_character", "get_player_items", "get_player_count", "add_gold", "current_wave", "nb_of_waves"], "our_file": "src/hue_run.gd", "purpose": "Who is playing, which wave, items owned, materials"},
    {"id": "hook_input",           "kind": "call",      "target": "res://singletons/input_service.gd", "members": ["enable_gamepad_movement", "disable_gamepad_movement"], "our_file": "mod_main.gd", "purpose": "These reload the InputMap from project settings, dropping the mod's actions; the mod re-adds them"},
    {"id": "hook_music",           "kind": "call",      "target": "res://singletons/music_manager.gd", "members": ["player"], "our_file": "src/hue_audio.gd", "purpose": "Pause Brotato's track while Hue's region music plays"},
    {"id": "hook_main_nodes",      "kind": "call",      "target": "res://main.gd", "members": ["_tile_map", "_background", "_wave_timer", "_entity_spawner", "_players", "_entities_container", "_enemy_projectiles", "_is_run_won"], "our_file": "src/hue_run.gd", "purpose": "Tint the arena floor; time and place the fragment; find players and bullets"},
    {"id": "hook_player_heal",     "kind": "call",      "target": "res://entities/units/player/player.gd", "members": ["heal", "max_stats", "dead"], "our_file": "src/hue_run.gd", "purpose": "Synergy heals"},
    {"id": "hook_neutrals", "kind": "call", "target": "res://global/entity_spawner.gd", "members": ["neutral_respawned", "neutrals"], "our_file": "src/hue_run.gd", "purpose": "Turn each of Brotato's trees into one of Hue's crates as it spawns"},
    {"id": "hook_neutral_nodes", "kind": "call", "target": "res://entities/units/neutral/neutral.gd", "members": ["sprite", "_hurtbox", "dead", "died"], "our_file": "src/hue_crate.gd", "purpose": "Crate picture and colour on a tree; hide it when its colour is the background"},
    {"id": "hook_zone", "kind": "call", "target": "res://singletons/zone_service.gd", "members": ["current_zone_min_position", "current_zone_max_position"], "our_file": "src/hue_hazards.gd", "purpose": "Arena bounds: where fragments, laser gates, boulders and dust go"},
    {"id": "hook_hazard_hitbox", "kind": "call", "target": "res://overlap/hitbox.gd", "members": ["damage", "deals_damage", "active", "hit_something"], "our_file": "src/hue_hazards.gd", "purpose": "Laser gates and boulders hurt Hue Potato with Brotato's own hitbox scene (overlap/hitbox.tscn) on the enemy-attack layer"},
    {"id": "hook_player_damage", "kind": "call", "target": "res://entities/units/player/player.gd", "members": ["take_damage", "_hurtbox"], "our_file": "src/hue_hazards.gd", "purpose": "Not called directly: the player's hurtbox finds the hazard hitbox and Brotato applies dodge, armour and invincibility frames"}
  ]
}
